# Get a Python image
FROM python:3.13.8-trixie

WORKDIR /app

# Set some meta information
LABEL description="Remote Container for CDA project development"
LABEL version="2.0"

# Install uv (the new package manager replacing pip + requirements.txt)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Don't copy the source code here - it will be mounted by devcontainer
# uv sync will be done in postCreateCommand after the workspace is mounted